<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 250" width="100%" height="100%">
  <defs>
    <linearGradient id="btnGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff9d3b"/>
      <stop offset="100%" stop-color="#e65c00"/>
    </linearGradient>
    <filter id="glow">
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#ff9d3b" flood-opacity="0.5"/>
    </filter>
  </defs>
  <g filter="url(#glow)" transform="translate(25, 25)">
    <rect x="0" y="0" width="450" height="200" rx="100" fill="url(#btnGrad)" stroke="#fff" stroke-width="4"/>
    <circle cx="90" cy="100" r="55" fill="#fff" opacity="0.2"/>
    <!-- Compass Icon -->
    <circle cx="90" cy="100" r="40" fill="none" stroke="#fff" stroke-width="4"/>
    <path d="M 90 68 L 102 90 L 90 132 L 78 110 Z" fill="#fff"/>
    <path d="M 90 68 L 90 100 L 102 90 Z" fill="#3b2a1e"/>

    <text x="280" y="95" font-family="'Montserrat', sans-serif" font-size="28" font-weight="900" fill="#fff" text-anchor="middle" letter-spacing="2">CLICK TO EXPLORE</text>
    <text x="280" y="135" font-family="'Georgia', serif" font-size="18" font-style="italic" fill="#fce8d5" text-anchor="middle">The Rodeo Kick Off Experience 🤠</text>
  </g>
</svg>
